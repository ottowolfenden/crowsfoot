            in
            (\p{start}) -- ($(\p{start})!0.5!(\p{end})$)
            let
            \n{offset} = {0.65cm},
            \n{radius} = {0.25cm},
            \p{mid}    = ($(\p{start})!0.5!(\p{end})$),
            \p{center} = ($(\p{end})!\n{offset}!(\p{start})$),
            in
            (\p{end}) -- ($(\p{end})!\n{offset}!(\p{start})!\n{radius}!(\p{end})$)
            ($(\p{end})!\n{offset}!(\p{start})!-\n{radius}!(\p{end})$) -- (\p{mid})
            (\p{center}) circle[radius=\n{radius}]
            \tikztonodes
        }
