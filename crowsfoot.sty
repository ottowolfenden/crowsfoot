\tikzset{
    default-default/.style={
        to path={
            let
            \p{s} = (\tikztostart),
            \p{e} = (\tikztotarget),
            \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
            \p{end} = (\tikztotarget.{atan2(\y{e}-\y{s},\x{e}-\x{s})+180}),
            in
            (\p{start}) -- ($(\p{start})!0.5!(\p{end})$)
            ($(\p{start})!0.5!(\p{end})$) -- (\p{end})
            \tikztonodes
        }
    },
    default-circ/.style={
        to path={
            let
            \p{s} = (\tikztostart),
            \p{e} = (\tikztotarget),
            \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
