% will automatically append the following after every let in the script:
% \p{s} = (\tikztostart),
% \p{e} = (\tikztotarget),
% \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
% \p{end} = (\tikztotarget.{atan2(\y{e}-\y{s},\x{e}-\x{s})+180}),

\tikzset{
    default.start/.style={
        to path={
            let
            \p{s} = (\tikztostart),
            \p{e} = (\tikztotarget),
            \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
            \p{end} = (\tikztotarget.{atan2(\y{e}-\y{s},\x{e}-\x{s})+180}),
            in
            (\p{start}) -- ($(\p{start})!0.5!(\p{end})$)
            \tikztonodes
        }
    },
    default.end/.style={
        to path={
            let
            \p{s} = (\tikztostart),
            \p{e} = (\tikztotarget),
            \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
            \p{end} = (\tikztotarget.{atan2(\y{e}-\y{s},\x{e}-\x{s})+180}),
            in
            ($(\p{start})!0.5!(\p{end})$) -- (\p{end})
            \tikztonodes
        }
    },
    circ.start/.style={
        to path={
            let
            \p{s} = (\tikztostart),
            \p{e} = (\tikztotarget),
            \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
            \p{end} = (\tikztotarget.{atan2(\y{e}-\y{s},\x{e}-\x{s})+180}),
            \p1 = ($(\p{start})!0.65cm!(\p{end})$),
            \p2 = ($(\p{start})!0.5!(\p{end})$)
            in
            (\p{start}) -- ($(\p1)!0.25cm!(\p{start})$)
            (\p2) -- ($(\p{start})!0.65cm!(\p2)!0.25cm!(\p2)$)
            (\p1) circle[radius=0.25cm]
            \tikztonodes
        }
    },
    circ.end/.style={
        to path={
            let
            \p{s} = (\tikztostart),
            \p{e} = (\tikztotarget),
            \p{start} = (\tikztostart.{atan2(\y{e}-\y{s},\x{e}-\x{s})}),
            \p{end} = (\tikztotarget.{atan2(\y{e}-\y{s},\x{e}-\x{s})+180}),
            \p1 = ($(\p{end})!0.65cm!(\p{start})$),
            \p2 = ($(\p{start})!0.5!(\p{end})$)
            in
            (\p{end}) -- ($(\p{end})!0.65cm!(\p{start})!0.25cm!(\p{end})$)
            ($(\p{end})!0.65cm!(\p{start})!-0.25cm!(\p{end})$) --
            (\p2)
            (\p1) circle[radius=0.25cm]
            \tikztonodes
        }
    },
