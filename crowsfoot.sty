\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{crowsfoot}[2026/11/14 Crows's foot TikZ diagrams]
\RequirePackage{tikz}
\usetikzlibrary{decorations.markings}

\tikzset{
    cf start/.style={
        decoration={
            markings,
            mark=at position 0 with {
                \draw (0.5,0) -- (0,0.3);
                \draw (0.5,0) -- (0,-0.3);
            }
        },
        postaction={decorate}
    },
    cf end/.style={
        decoration={
            markings,
            mark=at position 1 with {
                \draw (-0.5,0) -- (0,0.3);
                \draw (-0.5,0) -- (0,-0.3);
            }
        },
        postaction={decorate}
    },
    circ start/.style={
        decoration={
            markings,
            mark=at position 0 with {
                \node[circle, draw, minimum size=0.5cm] at (0.75,0) {};
            }
        },
        shorten <=1cm,
        postaction={decorate}
    },
    circ end/.style={
        decoration={
            markings,
            mark=at position 1 with {
                \node[circle, draw, minimum size=0.5cm] at (-0.75,0) {};
            }
        },
        shorten >=1cm,
        postaction={decorate}
    }
}

\tikzset{
    >-</.style={cf start, cf end},
    -</.style={cf end},
    >-/.style={cf start},
    o-o/.style={circ start, circ end},
    o-/.style={circ start},
    -o/.style={circ end},
}
